// Prisma schema for the GC AI assistant.
// Postgres is assumed (Vercel Postgres / Neon / Supabase all work).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenancy ---
// Every customer company is one Organization. Users belong to one org; all
// customer-owned data (projects, emails, tasks, decisions, ...) carries an
// orgId and every query must filter by it. Scraped Bid rows are public data
// and stay global; an org's private edits to a bid live in BidOverride.

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  projects       Project[]
  subcontractors Subcontractor[]
  emails         EmailRecord[]
  tasks          TaskItem[]
  decisions      BidDecisionLog[]
  bidOverrides   BidOverride[]
  invites        Invite[]
}

enum OrgRole {
  OWNER
  MEMBER
}

// Pending/accepted invitation to join an Organization. Single-use: the token
// is the secret in the invite link and is consumed when accepted.
model Invite {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String? // if set, only this Google account can accept
  token        String       @unique
  role         OrgRole      @default(MEMBER)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdById  String
  createdAt    DateTime     @default(now())

  @@index([orgId])
}

// --- Auth (NextAuth / Prisma adapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Google refresh token lives on Account (below); this flag just tracks
  // whether the user has granted Gmail + Calendar scopes at least once.
  googleConnected Boolean @default(false)

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])
  role  OrgRole        @default(MEMBER)

  createdAt DateTime @default(now())

  @@index([orgId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token           String? @db.Text
  access_token            String? @db.Text
  expires_at              Int?
  token_type              String?
  scope                   String?
  id_token                String? @db.Text
  session_state           String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Domain model ---

enum ProjectStatus {
  BIDDING
  AWARDED
  NOT_AWARDED
  PRECONSTRUCTION
  IN_PROGRESS
  ON_HOLD
  COMPLETE
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  address     String?
  status      ProjectStatus @default(BIDDING)
  projectType String? // e.g. "renovation", "new build", "road work" - from bid parsing
  startDate   DateTime?
  targetDate  DateTime?
  notes       String?       @db.Text

  subcontractors ProjectSubcontractor[]
  emails         EmailRecord[]
  tasks          TaskItem[]
  permits        Permit[]
  bid            Bid?                   @relation(fields: [bidId], references: [id])
  bidId          String?

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, bidId])
  @@index([orgId])
}

model Subcontractor {
  id      String  @id @default(cuid())
  name    String
  trade   String? // e.g. "electrical", "plumbing"
  email   String?
  phone   String?

  projects ProjectSubcontractor[]

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())

  @@index([orgId])
}

model ProjectSubcontractor {
  id              String        @id @default(cuid())
  projectId       String
  subcontractorId String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@unique([projectId, subcontractorId])
}

enum PermitStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model Permit {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  status      PermitStatus @default(NOT_SUBMITTED)
  submittedAt DateTime?
  approvedAt  DateTime?
  sourceEmailId String?
  notes       String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailCategory {
  SUBCONTRACTOR_UPDATE
  PERMIT
  BID_INVITE
  CLIENT
  SCHEDULING
  OTHER
}

model EmailRecord {
  id            String        @id @default(cuid())
  gmailId       String        @unique
  threadId      String?
  from          String
  subject       String
  receivedAt    DateTime
  snippet       String?       @db.Text
  category      EmailCategory @default(OTHER)
  summary       String?       @db.Text
  actionItem    String?       @db.Text
  requiresReply Boolean       @default(false)

  // Structured pre-bid/mandatory meeting info, extracted from the email body
  // only when explicitly stated (never guessed from an attachment reference).
  // Populated by classification; addedToCalendar flips once the GC confirms
  // it via the dashboard's "Confirm & add to Calendar" button.
  meetingTitle    String?
  meetingAt       DateTime?
  meetingAddress  String?
  addedToCalendar Boolean   @default(false)

  // Structured bid-opportunity info parsed from BID_INVITE email subjects,
  // which vary wildly in format between municipalities/agencies — extracted
  // by classification rather than regex so it holds up across naming styles.
  bidProjectNumber String?
  bidAgencyShort   String? // short/abbreviated agency name, e.g. "CFE Authority"
  bidSummary       String? // 1-3 word project description, e.g. "Safety Improvements"
  bidAddress       String? // physical address, or "Multiple addresses", or null
  bidMunicipality  String? // manual override of keyword-detected municipality

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  tasks TaskItem[]

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())

  @@index([orgId])
}

enum BidDecisionType {
  PLACED
  SKIPPED
  NOT_AWARDED
  DISMISSED
}

// Log of every "Placed Bid" / "Skip" decision the GC makes on a Bid
// Opportunity (whether it came from a scraped bid site or an email). Snapshots
// the opportunity's details at decision time so this stays meaningful for
// analysis even if the underlying Bid/EmailRecord is later cleaned up.
model BidDecisionLog {
  id           String           @id @default(cuid())
  sourceType   String // "bid" | "email"
  sourceId     String // Bid.id or EmailRecord.id
  decision     BidDecisionType
  reason       String? // only set when decision = SKIPPED
  title        String
  municipality String?
  trade        String?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orgId, sourceType, sourceId])
  @@index([orgId])
}

enum TaskStatus {
  TODO
  DONE
  DISMISSED
}

model TaskItem {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  source      String? // "email" | "manual" | "bid"

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  // Source email this task was generated from, if any — lets the dashboard
  // link a task straight to the Gmail message it came from.
  email   EmailRecord? @relation(fields: [emailId], references: [id])
  emailId String?

  // Which day's generated plan this belongs to (YYYY-MM-DD), for grouping.
  planDate String?

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

enum BidSource {
  MIAMI_DADE
  DEMANDSTAR
  HIALEAH_GARDENS
  DORAL
  MIAMI_SPRINGS
  MIAMI_SHORES
  MIAMI
  MIAMI_BEACH
  NORTH_MIAMI
  BAY_HARBOR_ISLANDS
  OPA_LOCKA
  FLORIDA_CITY
  SURFSIDE
  CUTLER_BAY
  MANUAL
}

model Bid {
  id              String    @id @default(cuid())
  source          BidSource
  externalId      String? // solicitation number / bid id from the source site
  title           String
  agency          String?
  projectType     String? // classified by Claude from the listing text
  openingDate     DateTime?
  postedDate      DateTime?
  preBidMeetingAt DateTime?
  url             String?
  rawText         String?   @db.Text
  addedToCalendar Boolean   @default(false)

  projects  Project[]
  overrides BidOverride[]

  createdAt DateTime @default(now())

  @@unique([source, externalId])
}

// One org's private edits to a (shared, scraped) Bid — e.g. the address or
// pre-bid meeting the scraper couldn't capture. Null fields fall back to the
// scraped value on the Bid itself.
model BidOverride {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  bidId String
  bid   Bid          @relation(fields: [bidId], references: [id], onDelete: Cascade)

  title                String?
  agency               String?
  municipality         String?
  address              String?
  projectType          String?
  openingDate          DateTime?
  preBidMeetingAt      DateTime?
  preBidMeetingAddress String?
  addedToCalendar      Boolean   @default(false)

  updatedAt DateTime @updatedAt

  @@unique([orgId, bidId])
}
